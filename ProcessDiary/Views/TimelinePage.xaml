<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProcessDiary.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProcessDiary.Views"
    xmlns:vm="using:ProcessDiary.ViewModels"
    Loaded="OnLoaded">

    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
            <local:FilterBar Filter="{x:Bind ViewModel.Filter}" />
            <Button
                Content="Show"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.LoadCommand}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Content="Delete selected"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.DeleteSelectedCommand}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="24" Height="24" VerticalAlignment="Bottom" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Message, Mode=OneWay}" />

        <TextBlock
            Grid.Row="2"
            Text="No activity was recorded in this period."
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Sessions}"
            SelectionMode="None"
            IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TimelineSessionViewModel">
                    <Grid Padding="0,8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                MinWidth="0"
                                AutomationProperties.Name="Select session" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind ApplicationName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind WindowTitle}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" VerticalAlignment="Center" />
                        </Grid>
                        <GridView
                            Grid.Row="1"
                            Margin="36,0,0,0"
                            ItemsSource="{x:Bind Screenshots}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnScreenshotClick">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimelineScreenshotViewModel">
                                    <Grid Width="180" RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="112" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image
                                            Source="{x:Bind ImageSource}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind FileExists}" />
                                        <Border
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="3"
                                            CornerRadius="4"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsPreviewed, Mode=OneWay}" />
                                        <TextBlock
                                            Text="Image file not found"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsMissing}" />
                                        <CheckBox
                                            Grid.Row="1"
                                            Content="{x:Bind CapturedText}"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

    <local:ResizeGrip
        Grid.Column="1"
        Width="8"
        Background="Transparent"
        Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}"
        PointerPressed="OnGripPointerPressed"
        PointerMoved="OnGripPointerMoved"
        PointerReleased="OnGripPointerReleased"
        PointerCanceled="OnGripPointerReleased">
        <Rectangle
            Width="2"
            HorizontalAlignment="Center"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </local:ResizeGrip>

    <Grid
        x:Name="PreviewPanel"
        Grid.Column="2"
        Width="480"
        Padding="16"
        RowSpacing="12"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="{x:Bind ViewModel.PreviewScreenshot.CapturedText, Mode=OneWay}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Content="Close"
                Command="{x:Bind ViewModel.ClosePreviewCommand}" />
        </Grid>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <Image
                    Source="{x:Bind ViewModel.PreviewScreenshot.ImageSource, Mode=OneWay}"
                    Stretch="Uniform" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.PreviewScreenshot.Details, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScreenshotDetail">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                <TextBlock Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button
                Content="Open in image viewer"
                Command="{x:Bind ViewModel.OpenPreviewImageCommand}" />
            <Button
                Content="Open image location"
                Command="{x:Bind ViewModel.ShowPreviewInFolderCommand}" />
            <Button
                Content="Delete"
                Command="{x:Bind ViewModel.DeletePreviewCommand}" />
        </StackPanel>
    </Grid>
    </Grid>
</Page>
