<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ProcessDiary"
		   Manufacturer="Christian Galla"
		   Version="$(Version)"
		   UpgradeCode="6d0418ff-2e2e-4547-998f-130f0e5f429c"
		   Scope="perMachine">

	<MajorUpgrade DowngradeErrorMessage="A newer version of ProcessDiary is already installed." />
	<MediaTemplate EmbedCab="yes" />

	<StandardDirectory Id="ProgramFiles64Folder">
	  <Directory Id="INSTALLFOLDER" Name="ProcessDiary">
		<Files Include="$(SourceDir)\**" />
	  </Directory>
	</StandardDirectory>

	<StandardDirectory Id="ProgramMenuFolder">
	  <Component Id="StartMenuShortcutComponent" Guid="b1a7c2d4-5e63-4f0a-9d3e-2c8f7a1e4b90">
		<Shortcut Id="StartMenuShortcut"
				  Name="ProcessDiary"
				  Target="[INSTALLFOLDER]ProcessDiary.exe"
				  WorkingDirectory="INSTALLFOLDER" />
		<RegistryValue Root="HKCU" Key="Software\ProcessDiary" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
	  </Component>
	</StandardDirectory>
  </Package>
</Wix>
