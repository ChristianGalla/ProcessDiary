<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProcessDiary.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock Text="Screenshots" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Folder" Text="{x:Bind ViewModel.ScreenshotFolder, Mode=TwoWay}" />
                    <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseCommand}" />
                </Grid>
                <NumberBox
                    Header="Take a screenshot every (seconds)"
                    Minimum="5"
                    SpinButtonPlacementMode="Inline"
                    SmallChange="5"
                    LargeChange="60"
                    Value="{x:Bind ViewModel.IntervalSeconds, Mode=TwoWay}" />
                <ComboBox
                    Header="Capture"
                    DisplayMemberPath="Label"
                    ItemsSource="{x:Bind ViewModel.Modes}"
                    SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" />
                <CheckBox
                    Content="Take a screenshot when the active application changes"
                    IsChecked="{x:Bind ViewModel.CaptureOnActivityChange, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Retention" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch
                    Header="Delete old data automatically"
                    IsOn="{x:Bind ViewModel.RetentionEnabled, Mode=TwoWay}" />
                <NumberBox
                    Header="Keep data for (days)"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    IsEnabled="{x:Bind ViewModel.RetentionEnabled, Mode=OneWay}"
                    Value="{x:Bind ViewModel.RetentionDays, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Privacy" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Text="Everything ProcessDiary records stays on this computer. Nothing is sent anywhere." />
                <Button Content="Delete all data…" Command="{x:Bind ViewModel.DeleteAllCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
