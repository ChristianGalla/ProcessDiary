<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProcessDiary.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProcessDiary.Views"
    xmlns:vm="using:ProcessDiary.ViewModels"
    Loaded="OnLoaded">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
            <local:FilterBar Filter="{x:Bind ViewModel.Filter}" />
            <Button
                Content="Show"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.LoadCommand}"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                Content="Delete selected"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.DeleteSelectedCommand}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="24" Height="24" VerticalAlignment="Bottom" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Message, Mode=OneWay}" />

        <TextBlock
            Grid.Row="2"
            Text="No activity was recorded in this period."
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

        <ListView
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Sessions}"
            SelectionMode="None"
            IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TimelineSessionViewModel">
                    <Grid Padding="0,8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                MinWidth="0"
                                AutomationProperties.Name="Select session" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind ApplicationName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind WindowTitle}" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" VerticalAlignment="Center" />
                        </Grid>
                        <GridView
                            Grid.Row="1"
                            Margin="36,0,0,0"
                            ItemsSource="{x:Bind Screenshots}"
                            SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimelineScreenshotViewModel">
                                    <Grid Width="180" RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="112" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image
                                            Source="{x:Bind ImageSource}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind FileExists}" />
                                        <TextBlock
                                            Text="Image file not found"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsMissing}" />
                                        <CheckBox
                                            Grid.Row="1"
                                            Content="{x:Bind CapturedText}"
                                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
