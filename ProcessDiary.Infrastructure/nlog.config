<?xml version="1.0" encoding="utf-8"?>
<!--
  ProcessDiary logging configuration (NLog).
  This file is read when ProcessDiary starts and reloaded automatically when it changes, so it can be edited after installation.
  A copy placed at %LOCALAPPDATA%\ProcessDiary\nlog.config takes precedence over this file.
  Logs stay on this computer; do not add network targets. Never log screenshot contents or window titles.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <targets>
    <target xsi:type="File"
            name="file"
            fileName="${specialfolder:folder=LocalApplicationData}/ProcessDiary/logs/processdiary.log"
            archiveEvery="Day"
            archiveSuffixFormat="_{1:yyyy-MM-dd}"
            maxArchiveFiles="14"
            layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:inner=|${exception:format=ToString}}" />
  </targets>

  <rules>
    <!-- Database commands may contain user data, so only warnings and errors are kept from EF Core. -->
    <logger name="Microsoft.EntityFrameworkCore.*" minlevel="Warn" writeTo="file" final="true" />
    <logger name="*" minlevel="Info" writeTo="file" />
  </rules>
</nlog>
